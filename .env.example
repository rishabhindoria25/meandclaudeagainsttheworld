# Required — Claude analyzes the photo and writes the plan.
ANTHROPIC_API_KEY=

# Optional overrides
# GLOW_MODEL=claude-opus-5
# GLOW_EFFORT=high            # low | medium | high | xhigh | max

# Optional — photoreal "after" image. First one configured wins, open-source
# first. Without any, Glow renders an on-device retouch preview instead.

# 1) Your own GPU running inference/server.py (Qwen-Image-Edit-2511, Apache-2.0)
# GLOW_OSS_URL=http://localhost:8000
# GLOW_OSS_TOKEN=

# 2) The same open model, hosted
# FAL_KEY=
# GLOW_FAL_MODEL=fal-ai/qwen-image-edit-2511
# REPLICATE_API_TOKEN=
# GLOW_REPLICATE_MODEL=qwen/qwen-image-edit-plus

# 3) Proprietary models
# GEMINI_API_KEY=
# GLOW_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_API_KEY=
# GLOW_OPENAI_IMAGE_MODEL=gpt-image-1
